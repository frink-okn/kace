# ── LakeFS ──
LAKEFS_ACCESS_KEY=
LAKEFS_SECRET_KEY=
LAKEFS_URL=https://frink-lakefs.apps.renci.org
LAKEFS_PUBLIC_URL=

# ── Storage / PVCs ──
SHARED_DATA_DIR=
LOCAL_DATA_DIR=
K8S_NAMESPACE=
SHARED_PVC_NAME=
LOCAL_PVC_NAME=

# ── Callbacks ──
HDT_UPLOAD_CALLBACK_URL=http://localhost:9898/upload_hdt_callback
NEO4J_UPLOAD_CALLBACK_URL=http://localhost:9898/upload_neo4j_files

# ── Spider ──
SPIDER_IP=
SPIDER_PORT=9090

# ── Frink ──
FRINK_ADDRESS=https://frink.apps.renci.org

# ── Slack ──
SLACK_URL=
SLACK_TOKEN=
SLACK_CHANNEL=

# ── Email ──
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=25
STOP_EMAIL=

# ── GitHub ──
GH_TOKEN=

# ── KG Config ──
KG_CONFIG_URL=https://raw.githubusercontent.com/frink-okn/okn-registry/refs/heads/main/docs/registry/kgs.yaml

# ── Temporal ──
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Weekly QLever index build schedule ──
# Upserted on worker boot. Set ENABLED=false to register it paused.
QLEVER_INDEX_SCHEDULE_ENABLED=true
QLEVER_INDEX_SCHEDULE_ID=qlever-index-weekly
QLEVER_INDEX_SCHEDULE_CRON=0 18 * * 5
QLEVER_INDEX_SCHEDULE_TIMEZONE=UTC

# ── Webhook authentication ──
# Shared secret every request must send as `X-KACE-Token`. Unset = the server
# rejects everything with 503 (fail closed). On the lakeFS side the same value
# must be exported as LAKEFSACTIONS_KACE_TOKEN — lakeFS blocks env vars in hook
# templates unless they carry that prefix.
WEBHOOK_TOKEN=

# ── Remote (serving) cluster ──
# Set these only when batch work and SPARQL serving run on different clusters.
# Empty REMOTE_KUBECONFIG = single-cluster mode: every "remote" call stays local.
# The kubeconfig must be static (SA token + CA + server URL); a gcloud
# exec-plugin kubeconfig will not work. See deploy/gke-remote-rbac.yaml.
REMOTE_KUBECONFIG=
REMOTE_KUBE_CONTEXT=
REMOTE_NAMESPACE=

# ── Federated index transfer ──
# An RWO PVC cannot span clusters, so a finished index travels build → bucket →
# serving. Empty bucket = no transfer (single-cluster). GCS works over its
# S3-compatible endpoint with HMAC keys.
QLEVER_INDEX_BUCKET=
QLEVER_INDEX_BUCKET_ENDPOINT=https://storage.googleapis.com
QLEVER_INDEX_BUCKET_ACCESS_KEY=
QLEVER_INDEX_BUCKET_SECRET_KEY=
# Storage class for the PVC the federation server mounts (serving cluster);
# QLEVER_INDEX_PVC_STORAGE_CLASS is the build cluster's.
QLEVER_INDEX_SERVING_STORAGE_CLASS=premium-rwo
