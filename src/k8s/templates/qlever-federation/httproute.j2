apiVersion: gateway.networking.k8s.io/v1beta1
kind: HTTPRoute
metadata:
  name: frink-federation-qlever-route
spec:
  parentRefs:
  - name: ingress-gateway
    namespace: ingress
  hostnames:
  - "{{ host_name }}"
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: "/{{ federation_prefix }}"
{% if throttle_enabled %}
    # nginx throttle proxy rewrites /federation -> / itself (see qlever/httproute.j2).
    backendRefs:
    - name: {{ throttle_service }}
      port: {{ throttle_port }}
{% else %}
    backendRefs:
    - name: frink-federation-qlever-server
      port: 7001
    filters:
    - type: URLRewrite
      urlRewrite:
        path:
          type: ReplacePrefixMatch
          replacePrefixMatch: "/"
{% endif %}
