apiVersion: http.keda.sh/v1alpha1
kind: HTTPScaledObject
metadata:
  name: {{ kg_name }}-qlever
  labels:
    app: frink-{{ kg_name }}-qlever-server
    kace.frink/role: qlever
spec:
  # The Host header httproute.j2 rewrites to. Not DNS -- just a unique key per KG
  # inside the shared interceptor's routing table.
  hosts:
  - "{{ kg_name }}.qlever.frink.internal"
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: frink-{{ kg_name }}-qlever-server
    # Where the interceptor forwards once the pod is Ready.
    service: frink-{{ kg_name }}-qlever-server
    port: 7001
  # max 1, not because of load but because of the volume: one RWO PVC per KG, so
  # a second replica could not mount it. min 0 is the point of the exercise.
  replicas:
    min: 0
    max: 1
  # 15 minutes idle before scaling back to zero. Traffic is ~2 organic requests
  # per day fleet-wide, so this number costs nothing either way -- it is sized
  # against cold-start cost (a QLever index mmap), not against hit rate.
  scaledownPeriod: {{ keda_scaledown_period | default(900) }}
  scalingMetric:
    # requestRate rather than concurrency: capped at one replica, the only
    # decision this makes is zero-or-one, so the target value never binds.
    requestRate:
      granularity: 1s
      targetValue: 100
      window: 1m
