apiVersion: apps/v1
kind: Deployment
metadata:
  name: frink-{{ kg_name }}-qlever-server
  labels:
    app: frink-{{ kg_name }}-qlever-server
    version: "{{ version }}"
    # The fleet has no group label, so every tool that wanted "all the per-KG
    # servers" matched the name regex `-qlever-server$` -- which also matches
    # federation, the one that must never be scaled down. This is the label to
    # select on instead.
    kace.frink/role: qlever
spec:
  # No `replicas`. KEDA owns this Deployment's replica count through its
  # HTTPScaledObject (min 0), and create_or_update_deployment patches with a
  # strategic merge, so a rendered `replicas: 1` would reset a KG that is
  # correctly scaled to zero back to warm on every redeploy. Omitting the field
  # leaves the live value alone on patch, and defaults to 1 on first create --
  # which KEDA then scales down once the KG goes idle.
  #
  # Recreate, because this is a single-replica database on a ReadWriteOnce PVC.
  # A RollingUpdate surges a second pod that cannot mount the volume until the
  # first releases it, which deadlocks on Multi-Attach. halve_sizing.py set this
  # on the running fleet; newly created KGs were still getting the default.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: frink-{{ kg_name }}-qlever-server
  template:
    metadata:
      labels:
        app: frink-{{ kg_name }}-qlever-server
        version: "{{ version }}"
    spec:
      # No initContainers. The index must already be on the PVC before this
      # Deployment is created -- fetching it is now a separate step in KACE, not
      # something every pod start repeats.
      #
      # Two reasons it moved out:
      #
      # 1. Cost. Kubernetes schedules, and GKE bills, a pod at
      #        max( sum(containers), max(initContainers) )
      #    so an init container larger than the app container is paid for over
      #    the pod's whole life, not just while it runs. `fetch-index` sat at
      #    exactly 2x the qlever-server container -- halve_sizing.py halved
      #    `containers` and never touched `initContainers` -- so that resizing
      #    saved $0. Across 36 of 41 KGs that was 15.2 vCPU + 99 GiB, ~$31/day.
      #
      # 2. Start time. `s5cmd cp` had no skip-if-present check, so every restart
      #    re-downloaded the entire index. That makes a pod restart expensive and
      #    scale-to-zero unworkable, because a cold start would mean refetching
      #    the whole index before answering one query.
      #
      # Removing this from the template does NOT remove it from running
      # Deployments: KACE patches (server_man.py:112, strategic merge), and a
      # merge patch never deletes what it does not mention. Existing workloads
      # need an explicit delete -- see cost-dashboard/strip_init_containers.py.
      containers:
      - name: qlever-server
        image: {{ qlever_image }}
        command:
        - qlever-server
        - -i
        - /data/{{ kg_name }}/{{ kg_name }}
        - -p
        - "7001"
        {% for arg in qlever_args %}
        - "{{ arg }}"
        {% endfor %}
        ports:
        - containerPort: 7001
        # Without this, `Ready` means the process started, not that the index is
        # loaded -- and a Service's Endpoints only contain Ready pods, so the KEDA
        # interceptor would forward a held request into a pod that cannot answer
        # yet. `ASK {}` is the same query the GKE load balancer used to send from
        # outside the cluster; here the kubelet sends it, and only while the pod
        # is actually up.
        readinessProbe:
          httpGet:
            path: /?query=ASK%20%7B%7D
            port: 7001
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          # 5 minutes of index load before the pod is called broken. The slowest
          # measured cold start with the index already on the PVC was 22s.
          failureThreshold: 60
        resources:
          requests:
            cpu: "{{ cpu }}"
            memory: "{{ memory }}"
          limits:
            memory: "{{ memory }}"
        volumeMounts:
        - name: data
          mountPath: /data
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: {{ pvc_name }}
