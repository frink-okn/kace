apiVersion: apps/v1
kind: Deployment
metadata:
  name: frink-{{ kg_name }}-qlever-server
  labels:
    app: frink-{{ kg_name }}-qlever-server
    version: "{{ version }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frink-{{ kg_name }}-qlever-server
  template:
    metadata:
      labels:
        app: frink-{{ kg_name }}-qlever-server
        version: "{{ version }}"
    spec:
      # No initContainers. The index must already be on the PVC before this
      # Deployment is created -- fetching it is now a separate step in KACE, not
      # something every pod start repeats.
      #
      # Two reasons it moved out:
      #
      # 1. Cost. Kubernetes schedules, and GKE bills, a pod at
      #        max( sum(containers), max(initContainers) )
      #    so an init container larger than the app container is paid for over
      #    the pod's whole life, not just while it runs. `fetch-index` sat at
      #    exactly 2x the qlever-server container -- halve_sizing.py halved
      #    `containers` and never touched `initContainers` -- so that resizing
      #    saved $0. Across 36 of 41 KGs that was 15.2 vCPU + 99 GiB, ~$31/day.
      #
      # 2. Start time. `s5cmd cp` had no skip-if-present check, so every restart
      #    re-downloaded the entire index. That makes a pod restart expensive and
      #    scale-to-zero unworkable, because a cold start would mean refetching
      #    the whole index before answering one query.
      #
      # Removing this from the template does NOT remove it from running
      # Deployments: KACE patches (server_man.py:112, strategic merge), and a
      # merge patch never deletes what it does not mention. Existing workloads
      # need an explicit delete -- see cost-dashboard/strip_init_containers.py.
      containers:
      - name: qlever-server
        image: adfreiburg/qlever:latest
        command:
        - qlever-server
        - -i
        - /data/{{ kg_name }}/{{ kg_name }}
        - -p
        - "7001"
        {% for arg in qlever_args %}
        - "{{ arg }}"
        {% endfor %}
        ports:
        - containerPort: 7001
        resources:
          requests:
            cpu: "{{ cpu }}"
            memory: "{{ memory }}"
          limits:
            memory: "{{ memory }}"
        volumeMounts:
        - name: data
          mountPath: /data
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: {{ pvc_name }}
